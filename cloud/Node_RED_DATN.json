    { "id": "ui-hum-cht", "type": "ui_chart", "z": "tab-fire-001", "name": "Chart Hum", "group": "grp-sensors-001", "order": 8, "width": 6, "height": 3, "label": "Do am (%RH)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "dot": false, "ymin": "0", "ymax": "100", "removeOlder": 1, "removeOlderPoints": "60", "removeOlderUnit": "3600", "cutout": 0, "colors": ["#40c4ff","#aec7e8","#ffbb78","#2ca02c","#98df8a","#d62728","#ff9896"], "useOneColor": true, "useUTC": false, "className": "", "outputs": 1, "x": 870, "y": 80, "wires": [[]] },
    { "id": "ui-eco2-cht", "type": "ui_chart", "z": "tab-fire-001", "name": "Chart eCO2", "group": "grp-sensors-001", "order": 9, "width": 6, "height": 3, "label": "eCO2 (ppm)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "dot": false, "ymin": "0", "ymax": "4000", "removeOlder": 1, "removeOlderPoints": "60", "removeOlderUnit": "3600", "cutout": 0, "colors": ["#ffd740","#c5b0d5","#ffbb78","#1f77b4","#2ca02c","#d62728","#ff9896"], "useOneColor": true, "useUTC": false, "className": "", "outputs": 1, "x": 870, "y": 120, "wires": [[]] },
    { "id": "ui-tvoc-cht", "type": "ui_chart", "z": "tab-fire-001", "name": "Chart TVOC", "group": "grp-sensors-001", "order": 10, "width": 6, "height": 3, "label": "TVOC (ppb)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "dot": false, "ymin": "0", "ymax": "1500", "removeOlder": 1, "removeOlderPoints": "60", "removeOlderUnit": "3600", "cutout": 0, "colors": ["#b388ff","#c7c7c7","#ffbb78","#1f77b4","#2ca02c","#d62728","#ff9896"], "useOneColor": true, "useUTC": false, "className": "", "outputs": 1, "x": 870, "y": 160, "wires": [[]] },
    { "id": "ui-mq2-cht", "type": "ui_chart", "z": "tab-fire-001", "name": "Chart MQ2", "group": "grp-sensors-001", "order": 11, "width": 6, "height": 3, "label": "MQ-2 (mV)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "dot": false, "ymin": "0", "ymax": "5000", "removeOlder": 1, "removeOlderPoints": "60", "removeOlderUnit": "3600", "cutout": 0, "colors": ["#ffab40","#aec7e8","#ffbb78","#2ca02c","#98df8a","#d62728","#ff9896"], "useOneColor": true, "useUTC": false, "className": "", "outputs": 1, "x": 870, "y": 200, "wires": [[]] },
    { "id": "ui-flame-cht", "type": "ui_chart", "z": "tab-fire-001", "name": "Chart Flame", "group": "grp-sensors-001", "order": 12, "width": 6, "height": 3, "label": "Flame IR (mV)", "chartType": "line", "legend": "false", "xformat": "HH:mm:ss", "interpolate": "linear", "nodata": "", "dot": false, "ymin": "0", "ymax": "5000", "removeOlder": 1, "removeOlderPoints": "60", "removeOlderUnit": "3600", "cutout": 0, "colors": ["#ff6e40","#aec7e8","#ffbb78","#2ca02c","#98df8a","#d62728","#ff9896"], "useOneColor": true, "useUTC": false, "className": "", "outputs": 1, "x": 870, "y": 240, "wires": [[]] },
