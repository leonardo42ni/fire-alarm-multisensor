    {
        "id": "fn-parse-sensor",
        "type": "function",
        "z": "tab-fire-001",
        "name": "Parse v2.0 Sensor Payload",
        "func": "var d = msg.payload || {};\nvar node = d.node_id || msg.topic || 'node';\nvar temp = (d.temp !== undefined) ? d.temp : d.temperature;\nvar hum  = (d.hum  !== undefined) ? d.hum  : d.humidity;\nvar eco2 = (d.eco2 !== undefined) ? d.eco2 : d.co2;\nvar tvoc = d.tvoc;\nvar mq2  = d.mq2_mv;\nvar flm  = d.flame_mv;\nvar risk = (d.risk !== undefined) ? Number(d.risk) : 0;\nvar st   = (d.state !== undefined) ? Number(d.state) : 0;\nvar seq  = (d.seq !== undefined) ? d.seq : '---';\nvar flags = (d.flags !== undefined) ? d.flags : 0;\nvar names = ['NORMAL (BINH THUONG)', 'CAUTION (CHU Y)', 'WARNING (CANH BAO)', 'FIRE (BAO CHAY!)'];\nvar stText = names[st] || ('STATE_' + st);\nvar tsStr = (d.ts && d.ts > 0) ? new Date(d.ts * 1000).toLocaleTimeString() : new Date().toLocaleTimeString();\nfunction out(val, topic) {\n    if (val === undefined || val === null || isNaN(Number(val))) return null;\n    return { payload: Number(val), topic: topic };\n}\nreturn [\n    out(temp, node),\n    out(hum, node),\n    out(eco2, node),\n    out(tvoc, node),\n    out(mq2, node),\n    out(flm, node),\n    { payload: risk, topic: node },\n    { payload: stText },\n    { payload: 'seq=' + seq + ' | flags=0x' + Number(flags).toString(16) },\n    { payload: tsStr + ' (' + node + ')' }\n];",
        "outputs": 10,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 180,
        "wires": [
            ["ui-temp-txt", "ui-temp-cht"],
            ["ui-hum-txt", "ui-hum-cht"],
            ["ui-eco2-txt", "ui-eco2-cht"],
            ["ui-tvoc-txt", "ui-tvoc-cht"],
            ["ui-mq2-txt", "ui-mq2-cht"],
            ["ui-flame-txt", "ui-flame-cht"],
            ["ui-risk-gauge", "ui-risk-cht"],
            ["ui-state-banner"],
            ["ui-flags-txt"],
            ["ui-last-seen"]
        ]
    },
    {
        "id": "fn-parse-alert",
        "type": "function",
        "z": "tab-fire-001",
        "name": "Parse Alert Payload",
        "func": "var d = msg.payload || {};\nvar st = (d.state !== undefined) ? Number(d.state) : 0;\nvar risk = (d.risk !== undefined) ? Number(d.risk) : 0;\nvar names = ['NORMAL (BINH THUONG)', 'CAUTION (CHU Y)', 'WARNING (CANH BAO)', 'FIRE (BAO CHAY!)'];\nreturn [\n    { payload: names[st] || ('STATE_' + st) },\n    { payload: risk }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 300,
        "wires": [["ui-state-banner"], ["ui-risk-gauge"]]
    },
