    },
    {
        "id": "inj-init-001",
        "type": "inject",
        "z": "tab-fire-001",
        "name": "Init Defaults",
        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.2,
        "topic": "",
        "payload": "{}",
        "payloadType": "json",
        "x": 130,
        "y": 60,
        "wires": [["fn-init-001"]]
    },
    {
        "id": "fn-init-001",
        "type": "function",
        "z": "tab-fire-001",
        "name": "Init UI Widgets",
        "func": "return [\n    { payload: 0 },\n    { payload: 0 },\n    { payload: 0 },\n    { payload: 0 },\n    { payload: 0 },\n    { payload: 0 },\n    { payload: 0 },\n    { payload: 'NORMAL (CHO DU LIEU)' },\n    { payload: 'seq=--- | flags=0x0' },\n    { payload: '---' },\n    { payload: 'waiting...' }\n];",
        "outputs": 11,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 60,
