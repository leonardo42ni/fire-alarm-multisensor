        "id": "trig-offline",
        "type": "trigger",
        "z": "tab-fire-001",
        "name": "30s Watchdog",
        "op1": "",
        "op2": "OFFLINE",
        "op1type": "nul",
        "op2type": "str",
        "duration": "30",
        "extend": true,
        "overrideDelay": false,
        "units": "s",
        "reset": "",
        "bytopic": "all",
        "outputs": 1,
        "x": 360,
        "y": 120,
