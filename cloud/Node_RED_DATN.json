    {
        "id": "mqtt-broker-001",
        "type": "mqtt-broker",
        "name": "Cloud MQTT Broker (TLS 8883)",
        "broker": "YOUR_EMQX_OR_HIVEMQ_HOST",
        "port": "8883",
        "tls": "tls-cfg-001",
        "clientid": "",
        "autoConnect": true,
        "usetls": true,
        "protocolVersion": "4",
        "keepalive": "30",
